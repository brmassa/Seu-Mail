@using Seu.Mail.Search.Models
@using Seu.Mail.Search.Services
@using SearchCriteria = Seu.Mail.Search.Models.EmailSearchCriteria
@inject IEmailSearchService SearchService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<div class="search-component">
    <!-- Quick Search Bar -->
    <div class="input-group mb-3">
        <input type="text" class="form-control search-input" @bind="SearchQuery" @bind:event="oninput"
               @onkeypress="HandleKeyPress" @onfocus="ShowSuggestions" @onblur="HideSuggestionsDelayed"
               placeholder="Search emails (e.g., from:alice has:attachment larger:1MB)"
               autocomplete="off" />
        <button class="btn btn-outline-primary" type="button" @onclick="ExecuteSearch">
            <i class="fas fa-search"></i>
        </button>
        <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
            <i class="fas fa-sliders-h"></i>
        </button>
        <ul class="dropdown-menu dropdown-menu-end advanced-dropdown">
            <li><h6 class="dropdown-header">Advanced Search</h6></li>
            <li><hr class="dropdown-divider"></li>
            <li class="px-3">
                <button class="btn btn-sm btn-outline-primary w-100" @onclick="ShowAdvancedSearch">
                    <i class="fas fa-cog me-1"></i> Advanced Options
                </button>
            </li>
        </ul>
    </div>

    <!-- Search Suggestions -->
    @if (ShowingSuggestions && Suggestions.Any())
    {
        <div class="search-suggestions">
            <div class="list-group shadow-sm">
                @foreach (var suggestion in Suggestions.Take(8))
                {
                    <a class="list-group-item list-group-item-action py-2" @onclick="() => SelectSuggestion(suggestion)" @onclick:preventDefault="true">
                        <i class="fas fa-search me-2 text-muted"></i>
                        @suggestion
                    </a>
                }
                @if (PopularTerms.Any())
                {
                    <div class="list-group-item bg-light border-0">
                        <small class="text-muted">Popular searches:</small>
                        <div class="mt-1">
                            @foreach (var term in PopularTerms.Take(3))
                            {
                                <span class="badge bg-secondary me-1 cursor-pointer" @onclick="() => SelectSuggestion(term)">
                                    @term
                                </span>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <!-- Quick Filters -->
    <div class="quick-filters mb-3">
        <div class="btn-group btn-group-sm" role="group">
            <button type="button" class="btn @(QuickFilter == "unread" ? "btn-primary" : "btn-outline-secondary")"
                    @onclick='() => SetQuickFilter(QuickFilter == "unread" ? "" : "unread")'>
                <i class="fas fa-envelope"></i> Unread
            </button>
            <button type="button" class="btn @(QuickFilter == "attachments" ? "btn-primary" : "btn-outline-secondary")"
                    @onclick='() => SetQuickFilter(QuickFilter == "attachments" ? "" : "attachments")'>
                <i class="fas fa-paperclip"></i> Has Attachments
            </button>
            <button type="button" class="btn @(QuickFilter == "important" ? "btn-primary" : "btn-outline-secondary")"
                    @onclick='() => SetQuickFilter(QuickFilter == "important" ? "" : "important")'>
                <i class="fas fa-star"></i> Important
            </button>
            <button type="button" class="btn @(QuickFilter == "large" ? "btn-primary" : "btn-outline-secondary")"
                    @onclick='() => SetQuickFilter(QuickFilter == "large" ? "" : "large")'>
                <i class="fas fa-weight-hanging"></i> Large (>1MB)
            </button>
        </div>
        <div class="btn-group btn-group-sm ms-2" role="group">
            <button type="button" class="btn btn-outline-info dropdown-toggle" data-bs-toggle="dropdown">
                <i class="fas fa-clock"></i> Recent
            </button>
            <ul class="dropdown-menu">
                <li><a class="dropdown-item" @onclick='() => SetTimeFilter("today")'>Today</a></li>
                <li><a class="dropdown-item" @onclick='() => SetTimeFilter("week")'>This Week</a></li>
                <li><a class="dropdown-item" @onclick='() => SetTimeFilter("month")'>This Month</a></li>
                <li><a class="dropdown-item" @onclick='() => SetTimeFilter("year")'>This Year</a></li>
            </ul>
        </div>
    </div>

    <!-- Advanced Search Modal -->
    @if (ShowingAdvanced)
    {
        <div class="modal fade show" style="display: block;" tabindex="-1">
            <div class="modal-backdrop fade show" @onclick="HideAdvancedSearch"></div>
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">
                            <i class="fas fa-search-plus me-2"></i>
                            Advanced Email Search
                        </h5>
                        <button type="button" class="btn-close" @onclick="HideAdvancedSearch"></button>
                    </div>
                    <div class="modal-body">
                        <div class="row">
                            <!-- Left Column -->
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label">
                                        <i class="fas fa-user me-1"></i> From
                                    </label>
                                    <input type="text" class="form-control" @bind="AdvancedCriteria.From"
                                           placeholder="sender@example.com or Name">
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">
                                        <i class="fas fa-users me-1"></i> To
                                    </label>
                                    <input type="text" class="form-control" @bind="AdvancedCriteria.To"
                                           placeholder="recipient@example.com">
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">
                                        <i class="fas fa-copy me-1"></i> CC
                                    </label>
                                    <input type="text" class="form-control" @bind="AdvancedCriteria.Cc"
                                           placeholder="cc@example.com">
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">
                                        <i class="fas fa-envelope-open me-1"></i> Subject
                                    </label>
                                    <input type="text" class="form-control" @bind="AdvancedCriteria.Subject"
                                           placeholder="Subject contains...">
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">
                                        <i class="fas fa-align-left me-1"></i> Body Text
                                    </label>
                                    <input type="text" class="form-control" @bind="AdvancedCriteria.Body"
                                           placeholder="Body contains...">
                                </div>
                            </div>

                            <!-- Right Column -->
                            <div class="col-md-6">
                                <div class="row">
                                    <div class="col-6">
                                        <div class="mb-3">
                                            <label class="form-label">
                                                <i class="fas fa-calendar-alt me-1"></i> Date From
                                            </label>
                                            <input type="date" class="form-control" @bind="DateFrom">
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="mb-3">
                                            <label class="form-label">Date To</label>
                                            <input type="date" class="form-control" @bind="DateTo">
                                        </div>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">
                                        <i class="fas fa-folder me-1"></i> Folder
                                    </label>
                                    <select class="form-select" @bind="AdvancedCriteria.FolderName">
                                        <option value="">All Folders</option>
                                        <option value="INBOX">Inbox</option>
                                        <option value="SENT">Sent</option>
                                        <option value="DRAFTS">Drafts</option>
                                        <option value="TRASH">Trash</option>
                                        <option value="SPAM">Spam</option>
                                    </select>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">
                                        <i class="fas fa-paperclip me-1"></i> Attachments
                                    </label>
                                    <input type="text" class="form-control" @bind="AdvancedCriteria.AttachmentName"
                                           placeholder="Filename contains...">
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">File Type</label>
                                    <select class="form-select" @bind="AdvancedCriteria.AttachmentType">
                                        <option value="">Any Type</option>
                                        <option value="pdf">PDF</option>
                                        <option value="doc">Word Documents</option>
                                        <option value="xls">Excel Spreadsheets</option>
                                        <option value="jpg">Images (JPG)</option>
                                        <option value="png">Images (PNG)</option>
                                        <option value="zip">Archives (ZIP)</option>
                                    </select>
                                </div>

                                <div class="row">
                                    <div class="col-6">
                                        <div class="mb-3">
                                            <label class="form-label">
                                                <i class="fas fa-weight-hanging me-1"></i> Min Size
                                            </label>
                                            <select class="form-select" @bind="MinSizeSelection">
                                                <option value="">Any Size</option>
                                                <option value="1048576">1 MB</option>
                                                <option value="5242880">5 MB</option>
                                                <option value="10485760">10 MB</option>
                                                <option value="26214400">25 MB</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="mb-3">
                                            <label class="form-label">Max Size</label>
                                            <select class="form-select" @bind="MaxSizeSelection">
                                                <option value="">Any Size</option>
                                                <option value="1048576">1 MB</option>
                                                <option value="5242880">5 MB</option>
                                                <option value="10485760">10 MB</option>
                                                <option value="26214400">25 MB</option>
                                                <option value="104857600">100 MB</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Checkboxes -->
                        <div class="row">
                            <div class="col-md-4">
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" @bind="HasAttachmentsFilter" id="hasAttachments">
                                    <label class="form-check-label" for="hasAttachments">
                                        <i class="fas fa-paperclip me-1"></i> Has Attachments
                                    </label>
                                </div>
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" @bind="UnreadOnlyFilter" id="unreadOnly">
                                    <label class="form-check-label" for="unreadOnly">
                                        <i class="fas fa-envelope me-1"></i> Unread Only
                                    </label>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" @bind="ImportantOnlyFilter" id="importantOnly">
                                    <label class="form-check-label" for="importantOnly">
                                        <i class="fas fa-star me-1"></i> Important Only
                                    </label>
                                </div>
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" @bind="DraftOnlyFilter" id="draftOnly">
                                    <label class="form-check-label" for="draftOnly">
                                        <i class="fas fa-edit me-1"></i> Drafts Only
                                    </label>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" @bind="IncludeDeletedFilter" id="includeDeleted">
                                    <label class="form-check-label" for="includeDeleted">
                                        <i class="fas fa-trash me-1"></i> Include Deleted
                                    </label>
                                </div>
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" @bind="IncludeSpamFilter" id="includeSpam">
                                    <label class="form-check-label" for="includeSpam">
                                        <i class="fas fa-ban me-1"></i> Include Spam
                                    </label>
                                </div>
                            </div>
                        </div>

                        <!-- Sort Options -->
                        <div class="row mt-3">
                            <div class="col-md-6">
                                <label class="form-label">
                                    <i class="fas fa-sort me-1"></i> Sort by
                                </label>
                                <select class="form-select" @bind="AdvancedCriteria.SortOrder">
                                    <option value="@SearchSortOrder.DateDescending">Date (Newest First)</option>
                                    <option value="@SearchSortOrder.DateAscending">Date (Oldest First)</option>
                                    <option value="@SearchSortOrder.SenderAscending">Sender (A-Z)</option>
                                    <option value="@SearchSortOrder.SenderDescending">Sender (Z-A)</option>
                                    <option value="@SearchSortOrder.SubjectAscending">Subject (A-Z)</option>
                                    <option value="@SearchSortOrder.SubjectDescending">Subject (Z-A)</option>
                                    <option value="@SearchSortOrder.SizeDescending">Size (Largest First)</option>
                                    <option value="@SearchSortOrder.Relevance">Relevance</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">
                                    <i class="fas fa-list me-1"></i> Results per page
                                </label>
                                <select class="form-select" @bind="AdvancedCriteria.MaxResults">
                                    <option value="25">25</option>
                                    <option value="50">50</option>
                                    <option value="100">100</option>
                                    <option value="200">200</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="ResetAdvancedSearch">
                            <i class="fas fa-undo me-1"></i> Reset
                        </button>
                        <button type="button" class="btn btn-outline-secondary" @onclick="HideAdvancedSearch">
                            Cancel
                        </button>
                        <button type="button" class="btn btn-primary" @onclick="ExecuteAdvancedSearch">
                            <i class="fas fa-search me-1"></i> Search
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Search Help -->
    @if (ShowSearchHelp)
    {
        <div class="search-help mt-3">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h6 class="mb-0">
                        <i class="fas fa-question-circle me-2"></i>
                        Search Help
                    </h6>
                    <button type="button" class="btn-close" @onclick="() => ShowSearchHelp = false"></button>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <h6>Gmail-like Operators:</h6>
                            <ul class="list-unstyled small">
                                <li><code>from:alice</code> - emails from Alice</li>
                                <li><code>to:bob@company.com</code> - emails to Bob</li>
                                <li><code>subject:meeting</code> - emails with "meeting" in subject</li>
                                <li><code>has:attachment</code> - emails with attachments</li>
                                <li><code>filename:report.pdf</code> - specific attachment</li>
                            </ul>
                        </div>
                        <div class="col-md-6">
                            <h6>Date & Size Filters:</h6>
                            <ul class="list-unstyled small">
                                <li><code>after:2024-01-01</code> - emails after date</li>
                                <li><code>before:2024-12-31</code> - emails before date</li>
                                <li><code>larger:1MB</code> - emails larger than 1MB</li>
                                <li><code>smaller:100KB</code> - emails smaller than 100KB</li>
                                <li><code>is:unread</code> - unread emails</li>
                            </ul>
                        </div>
                    </div>
                    <div class="mt-2">
                        <small class="text-muted">
                            <strong>Pro tip:</strong> Combine operators like: <code>from:alice has:attachment larger:1MB</code>
                        </small>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .search-component {
        position: relative;
        max-width: 800px;
        margin: 0 auto;
    }

    .search-input:focus {
        border-color: #007bff;
        box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25);
    }

    .search-suggestions {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        z-index: 1050;
        margin-top: -1px;
        border-radius: 0 0 0.375rem 0.375rem;
    }

    .search-suggestions .list-group-item {
        border-left: 0;
        border-right: 0;
        border-radius: 0;
    }

    .search-suggestions .list-group-item:hover {
        background-color: #f8f9fa;
    }

    .cursor-pointer {
        cursor: pointer;
    }

    .advanced-dropdown {
        min-width: 250px;
    }

    .quick-filters .btn {
        font-size: 0.875rem;
    }

    .modal {
        background-color: rgba(0, 0, 0, 0.5);
    }

    .search-help code {
        background-color: #f8f9fa;
        color: #e83e8c;
        padding: 2px 4px;
        border-radius: 3px;
        font-size: 0.85em;
    }
</style>

@code {
    private string SearchQuery = "";
    private bool ShowingSuggestions = false;
    private bool ShowingAdvanced = false;
    private bool ShowSearchHelp = false;
    private string QuickFilter = "";

    private List<string> Suggestions = new();
    private List<string> PopularTerms = new();
    private Timer? _suggestionTimer;

    // Advanced search properties
    private SearchCriteria AdvancedCriteria = new();
    private DateTime? DateFrom;
    private DateTime? DateTo;
    private string MinSizeSelection = "";
    private string MaxSizeSelection = "";
    private bool HasAttachmentsFilter = false;
    private bool UnreadOnlyFilter = false;
    private bool ImportantOnlyFilter = false;
    private bool DraftOnlyFilter = false;
    private bool IncludeDeletedFilter = false;
    private bool IncludeSpamFilter = false;

    protected override async Task OnInitializedAsync()
    {
        // Load popular search terms
        try
        {
            PopularTerms = await SearchService.GetPopularSearchTermsAsync(10);
        }
        catch
        {
            PopularTerms = new List<string>
            {
                "from:support@company.com",
                "has:attachment",
                "is:unread",
                "subject:invoice",
                "larger:1MB"
            };
        }

        ResetAdvancedSearch();
    }

    private void HandleKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            ExecuteSearch();
        }
        else if (e.Key == "Escape")
        {
            HideSuggestions();
        }
        else if (e.Key == "?" && e.CtrlKey)
        {
            ShowSearchHelp = !ShowSearchHelp;
            StateHasChanged();
        }
        else
        {
            // Debounce suggestion loading
            _suggestionTimer?.Dispose();
            _suggestionTimer = new Timer(LoadSuggestionsDebounced, null, 300, Timeout.Infinite);
        }
    }

    private async void LoadSuggestionsDebounced(object? state)
    {
        await InvokeAsync(LoadSuggestions);
    }

    private async Task LoadSuggestions()
    {
        if (string.IsNullOrWhiteSpace(SearchQuery) || SearchQuery.Length < 2)
        {
            Suggestions.Clear();
            StateHasChanged();
            return;
        }

        try
        {
            Suggestions = await SearchService.GetSearchSuggestionsAsync(SearchQuery, 8);
            StateHasChanged();
        }
        catch
        {
            Suggestions.Clear();
        }
    }

    private void ExecuteSearch()
    {
        if (string.IsNullOrWhiteSpace(SearchQuery)) return;

        HideSuggestions();
        Navigation.NavigateTo($"/search?q={Uri.EscapeDataString(SearchQuery)}");
    }

    private void ExecuteAdvancedSearch()
    {
        ApplyAdvancedFilters();

        if (HasAnySearchCriteria())
        {
            var query = BuildAdvancedQuery();
            SearchQuery = query;
            HideAdvancedSearch();
            ExecuteSearch();
        }
    }

    private void ApplyAdvancedFilters()
    {
        if (DateFrom.HasValue)
            AdvancedCriteria.After = DateFrom.Value;

        if (DateTo.HasValue)
            AdvancedCriteria.Before = DateTo.Value;

        if (!string.IsNullOrEmpty(MinSizeSelection) && long.TryParse(MinSizeSelection, out var minSize))
            AdvancedCriteria.LargerThanBytes = minSize;

        if (!string.IsNullOrEmpty(MaxSizeSelection) && long.TryParse(MaxSizeSelection, out var maxSize))
            AdvancedCriteria.SmallerThanBytes = maxSize;

        AdvancedCriteria.HasAttachment = HasAttachmentsFilter ? true : null;
        AdvancedCriteria.IsUnread = UnreadOnlyFilter ? true : null;
        AdvancedCriteria.IsImportant = ImportantOnlyFilter ? true : null;
        AdvancedCriteria.IsDraft = DraftOnlyFilter ? true : null;
        AdvancedCriteria.IncludeDeleted = IncludeDeletedFilter;
        AdvancedCriteria.IncludeSpam = IncludeSpamFilter;
    }

    private bool HasAnySearchCriteria()
    {
        return !string.IsNullOrWhiteSpace(AdvancedCriteria.From) ||
               !string.IsNullOrWhiteSpace(AdvancedCriteria.To) ||
               !string.IsNullOrWhiteSpace(AdvancedCriteria.Cc) ||
               !string.IsNullOrWhiteSpace(AdvancedCriteria.Subject) ||
               !string.IsNullOrWhiteSpace(AdvancedCriteria.Body) ||
               !string.IsNullOrWhiteSpace(AdvancedCriteria.AttachmentName) ||
               DateFrom.HasValue || DateTo.HasValue ||
               HasAttachmentsFilter || UnreadOnlyFilter || ImportantOnlyFilter || DraftOnlyFilter;
    }

    private string BuildAdvancedQuery()
    {
        var queryParts = new List<string>();

        if (!string.IsNullOrWhiteSpace(AdvancedCriteria.From))
            queryParts.Add($"from:{AdvancedCriteria.From}");

        if (!string.IsNullOrWhiteSpace(AdvancedCriteria.To))
            queryParts.Add($"to:{AdvancedCriteria.To}");

        if (!string.IsNullOrWhiteSpace(AdvancedCriteria.Cc))
            queryParts.Add($"cc:{AdvancedCriteria.Cc}");

        if (!string.IsNullOrWhiteSpace(AdvancedCriteria.Subject))
            queryParts.Add($"subject:{AdvancedCriteria.Subject}");

        if (!string.IsNullOrWhiteSpace(AdvancedCriteria.Body))
            queryParts.Add($"body:{AdvancedCriteria.Body}");

        if (!string.IsNullOrWhiteSpace(AdvancedCriteria.AttachmentName))
            queryParts.Add($"filename:{AdvancedCriteria.AttachmentName}");

        if (HasAttachmentsFilter)
            queryParts.Add("has:attachment");

        if (UnreadOnlyFilter)
            queryParts.Add("is:unread");

        if (ImportantOnlyFilter)
            queryParts.Add("is:important");

        if (DraftOnlyFilter)
            queryParts.Add("is:draft");

        if (DateFrom.HasValue)
            queryParts.Add($"after:{DateFrom.Value:yyyy-MM-dd}");

        if (DateTo.HasValue)
            queryParts.Add($"before:{DateTo.Value:yyyy-MM-dd}");

        if (AdvancedCriteria.LargerThanBytes.HasValue)
            queryParts.Add($"larger:{FormatSize(AdvancedCriteria.LargerThanBytes.Value)}");

        if (AdvancedCriteria.SmallerThanBytes.HasValue)
            queryParts.Add($"smaller:{FormatSize(AdvancedCriteria.SmallerThanBytes.Value)}");

        if (!string.IsNullOrWhiteSpace(AdvancedCriteria.FolderName))
            queryParts.Add($"in:{AdvancedCriteria.FolderName.ToLower()}");

        return string.Join(" ", queryParts);
    }

    private string FormatSize(long bytes)
    {
        if (bytes >= 1073741824) return $"{bytes / 1073741824}GB";
        if (bytes >= 1048576) return $"{bytes / 1048576}MB";
        if (bytes >= 1024) return $"{bytes / 1024}KB";
        return $"{bytes}B";
    }

    private void SelectSuggestion(string suggestion)
    {
        SearchQuery = suggestion;
        HideSuggestions();
        ExecuteSearch();
    }

    private void ShowSuggestions()
    {
        ShowingSuggestions = true;
        if (Suggestions.Any() || PopularTerms.Any())
        {
            StateHasChanged();
        }
        else
        {
            InvokeAsync(LoadSuggestions);
        }
    }

    private void HideSuggestions()
    {
        ShowingSuggestions = false;
        StateHasChanged();
    }

    private void HideSuggestionsDelayed()
    {
        // Small delay to allow clicking on suggestions
        _ = Task.Delay(200).ContinueWith(_ => InvokeAsync(() =>
        {
            ShowingSuggestions = false;
            StateHasChanged();
        }));
    }

    private void SetQuickFilter(string filter)
    {
        QuickFilter = filter;

        SearchQuery = filter switch
        {
            "unread" => "is:unread",
            "attachments" => "has:attachment",
            "important" => "is:important",
            "large" => "larger:1MB",
            _ => ""
        };

        if (!string.IsNullOrEmpty(SearchQuery))
        {
            ExecuteSearch();
        }

        StateHasChanged();
    }

    private void SetTimeFilter(string period)
    {
        var query = period switch
        {
            "today" => $"after:{DateTime.Today:yyyy-MM-dd}",
            "week" => $"after:{DateTime.Today.AddDays(-7):yyyy-MM-dd}",
            "month" => $"after:{DateTime.Today.AddMonths(-1):yyyy-MM-dd}",
            "year" => $"after:{DateTime.Today.AddYears(-1):yyyy-MM-dd}",
            _ => ""
        };

        if (!string.IsNullOrEmpty(query))
        {
            SearchQuery = query;
            ExecuteSearch();
        }
    }

    private void ShowAdvancedSearch()
    {
        ShowingAdvanced = true;
        StateHasChanged();
    }

    private void HideAdvancedSearch()
    {
        ShowingAdvanced = false;
        StateHasChanged();
    }

    private void ResetAdvancedSearch()
    {
        AdvancedCriteria = new SearchCriteria
        {
            MaxResults = 50,
            SortOrder = SearchSortOrder.DateDescending
        };
        DateFrom = null;
        DateTo = null;
        MinSizeSelection = "";
        MaxSizeSelection = "";
        HasAttachmentsFilter = false;
        UnreadOnlyFilter = false;
        ImportantOnlyFilter = false;
        DraftOnlyFilter = false;
        IncludeDeletedFilter = false;
        IncludeSpamFilter = false;
        StateHasChanged();
    }

    public void Dispose()
    {
        _suggestionTimer?.Dispose();
    }
}
