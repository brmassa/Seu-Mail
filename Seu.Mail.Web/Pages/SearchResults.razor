@page "/search"
@using Seu.Mail.Core.Models
@using Seu.Mail.Search.Models
@using Seu.Mail.Search.Services
@using SearchCriteria = Seu.Mail.Search.Models.EmailSearchCriteria
@inject IEmailSearchService SearchService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>Search Results</PageTitle>

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <h2 class="mb-4">
                <i class="fas fa-search me-2"></i>
                Search Results
                @if (SearchResult != null && !string.IsNullOrEmpty(Query))
                {
                    <small class="text-muted">for "@Query"</small>
                }
            </h2>

            @if (IsLoading)
            {
                <div class="d-flex justify-content-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Searching...</span>
                    </div>
                    <span class="ms-2">Searching emails...</span>
                </div>
            }
            else if (SearchResult != null)
            {
                @if (!string.IsNullOrEmpty(SearchResult.Error))
                {
                    <div class="alert alert-danger" role="alert">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        <strong>Search Error:</strong> @SearchResult.Error
                    </div>
                }
                else
                {
                    <!-- Search Results Summary -->
                    <div class="row mb-4">
                        <div class="col-md-8">
                            <div class="search-summary">
                                <p class="mb-1">
                                    <strong>@SearchResult.TotalCount</strong> results found
                                    @if (SearchResult.ExecutionTimeMs > 0)
                                    {
                                        <span class="text-muted">in @SearchResult.ExecutionTimeMs ms</span>
                                    }
                                </p>
                                @if (SearchResult.TotalCount > SearchResult.Emails.Count)
                                {
                                    <small class="text-muted">
                                        Showing @SearchResult.Emails.Count of @SearchResult.TotalCount results
                                        (Page @SearchResult.CurrentPage of @SearchResult.TotalPages)
                                    </small>
                                }
                            </div>
                        </div>
                        <div class="col-md-4 text-end">
                            @if (SearchResult.TotalCount > 0)
                            {
                                <div class="btn-group" role="group">
                                    <button type="button" class="btn btn-sm btn-outline-secondary dropdown-toggle"
                                            data-bs-toggle="dropdown">
                                        Sort: @GetSortDisplayName()
                                    </button>
                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item" href="#" @onclick="() => ChangeSorting(SearchSortOrder.DateDescending)">
                                            Date (Newest First)</a></li>
                                        <li><a class="dropdown-item" href="#" @onclick="() => ChangeSorting(SearchSortOrder.DateAscending)">
                                            Date (Oldest First)</a></li>
                                        <li><a class="dropdown-item" href="#" @onclick="() => ChangeSorting(SearchSortOrder.SenderAscending)">
                                            Sender (A-Z)</a></li>
                                        <li><a class="dropdown-item" href="#" @onclick="() => ChangeSorting(SearchSortOrder.SubjectAscending)">
                                            Subject (A-Z)</a></li>
                                        <li><a class="dropdown-item" href="#" @onclick="() => ChangeSorting(SearchSortOrder.SizeDescending)">
                                            Size (Largest First)</a></li>
                                        <li><a class="dropdown-item" href="#" @onclick="() => ChangeSorting(SearchSortOrder.Relevance)">
                                            Relevance</a></li>
                                    </ul>
                                </div>
                            }
                        </div>
                    </div>

                    @if (SearchResult.TotalCount == 0)
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-search fa-3x text-muted mb-3"></i>
                            <h4 class="text-muted">No emails found</h4>
                            <p class="text-muted mb-4">
                                Try adjusting your search terms or using different filters.
                            </p>
                            <div class="search-suggestions">
                                <h6>Search tips:</h6>
                                <ul class="list-unstyled text-start d-inline-block">
                                    <li><code>from:alice@example.com</code> - emails from specific sender</li>
                                    <li><code>subject:meeting</code> - emails with "meeting" in subject</li>
                                    <li><code>has:attachment</code> - emails with attachments</li>
                                    <li><code>larger:1MB</code> - emails larger than 1MB</li>
                                    <li><code>after:2024-01-01</code> - emails after specific date</li>
                                </ul>
                            </div>
                        </div>
                    }
                    else
                    {
                        <!-- Email Results -->
                        <div class="email-list">
                            @foreach (var email in SearchResult.Emails)
                            {
                                <div class="email-item border rounded mb-3 p-3 @(email.IsRead ? "" : "unread")">
                                    <div class="row">
                                        <div class="col-md-8">
                                            <div class="email-header">
                                                <div class="d-flex align-items-center mb-2">
                                                    <strong class="sender me-2">@email.From</strong>
                                                    @if (email.IsImportant)
                                                    {
                                                        <span class="badge bg-warning text-dark me-2">
                                                            <i class="fas fa-star"></i> Important
                                                        </span>
                                                    }
                                                    @if (email.HasAttachments)
                                                    {
                                                        <span class="badge bg-secondary me-2">
                                                            <i class="fas fa-paperclip"></i> @email.Attachments.Count
                                                        </span>
                                                    }
                                                    @if (!email.IsRead)
                                                    {
                                                        <span class="badge bg-primary">New</span>
                                                    }
                                                </div>
                                                <h6 class="email-subject mb-2">
                                                    <a href="/email/@email.Id" class="text-decoration-none">
                                                        @email.Subject
                                                    </a>
                                                </h6>
                                                <p class="email-preview text-muted mb-0">
                                                    @(TruncateText(email.TextBody ?? "", 200))
                                                </p>
                                            </div>
                                        </div>
                                        <div class="col-md-4 text-end">
                                            <div class="email-meta">
                                                <small class="text-muted d-block">
                                                    @email.DateReceived.ToString("MMM dd, yyyy")
                                                </small>
                                                <small class="text-muted d-block">
                                                    @email.DateReceived.ToString("HH:mm")
                                                </small>
                                                @if (email.Size > 0)
                                                {
                                                    <small class="text-muted d-block">
                                                        @FormatFileSize(email.Size)
                                                    </small>
                                                }
                                                <small class="text-muted d-block">
                                                    @email.Folder
                                                </small>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- Pagination -->
                        @if (SearchResult.TotalPages > 1)
                        {
                            <nav aria-label="Search results pagination">
                                <ul class="pagination justify-content-center">
                                    <li class="page-item @(SearchResult.CurrentPage <= 1 ? "disabled" : "")">
                                        <a class="page-link" href="#" @onclick="() => GoToPage(SearchResult.CurrentPage - 1)">
                                            <i class="fas fa-chevron-left"></i> Previous
                                        </a>
                                    </li>

                                    @for (int i = Math.Max(1, SearchResult.CurrentPage - 2);
                                          i <= Math.Min(SearchResult.TotalPages, SearchResult.CurrentPage + 2); i++)
                                    {
                                        <li class="page-item @(i == SearchResult.CurrentPage ? "active" : "")">
                                            <a class="page-link" href="#" @onclick="() => GoToPage(i)">@i</a>
                                        </li>
                                    }

                                    <li class="page-item @(SearchResult.CurrentPage >= SearchResult.TotalPages ? "disabled" : "")">
                                        <a class="page-link" href="#" @onclick="() => GoToPage(SearchResult.CurrentPage + 1)">
                                            Next <i class="fas fa-chevron-right"></i>
                                        </a>
                                    </li>
                                </ul>
                            </nav>
                        }
                    }
                }
            }
            else if (!string.IsNullOrEmpty(Query))
            {
                <div class="alert alert-info" role="alert">
                    <i class="fas fa-info-circle me-2"></i>
                    Enter a search query to find emails.
                </div>
            }
        </div>
    </div>
</div>

<style>
    .unread {
        background-color: #f8f9ff;
        border-left: 4px solid #007bff;
    }

    .email-item:hover {
        background-color: #f8f9fa;
        transition: background-color 0.2s ease;
    }

    .email-subject a {
        color: #333;
    }

    .email-subject a:hover {
        color: #007bff;
    }

    .search-summary {
        font-size: 0.9rem;
    }

    .email-preview {
        font-size: 0.85rem;
        line-height: 1.4;
    }

    .email-meta {
        font-size: 0.8rem;
    }

    .search-suggestions {
        text-align: left;
        max-width: 400px;
        margin: 0 auto;
    }

    .search-suggestions code {
        background-color: #f8f9fa;
        padding: 2px 4px;
        border-radius: 3px;
        font-size: 0.85em;
    }
</style>

@code {
    [Parameter, SupplyParameterFromQuery] public string? Query { get; set; }
    [Parameter, SupplyParameterFromQuery] public int Page { get; set; } = 1;
    [Parameter, SupplyParameterFromQuery] public string? Sort { get; set; }

    private EmailSearchResult? SearchResult { get; set; }
    private bool IsLoading { get; set; }
    private SearchCriteria CurrentCriteria { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrEmpty(Query))
        {
            await PerformSearch();
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrEmpty(Query))
        {
            await PerformSearch();
        }
    }

    private async Task PerformSearch()
    {
        if (string.IsNullOrWhiteSpace(Query))
            return;

        IsLoading = true;
        StateHasChanged();

        try
        {
            // Parse sort order
            var sortOrder = ParseSortOrder(Sort);

            // Check if this is a raw query (Gmail-like syntax) or simple keyword search
            if (IsAdvancedQuery(Query))
            {
                SearchResult = await SearchService.SearchAsync(Query);
            }
            else
            {
                // Simple keyword search
                var criteria = new SearchCriteria
                {
                    Keyword = Query,
                    MaxResults = 50,
                    Offset = (Page - 1) * 50,
                    SortOrder = sortOrder
                };
                CurrentCriteria = criteria;
                SearchResult = await SearchService.SearchAsync(criteria);
            }
        }
        catch (Exception ex)
        {
            SearchResult = new EmailSearchResult
            {
                Error = $"Search failed: {ex.Message}"
            };
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private bool IsAdvancedQuery(string query)
    {
        // Check if query contains Gmail-like operators
        var operators = new[] { "from:", "to:", "subject:", "has:", "is:", "in:", "larger:", "smaller:", "before:", "after:", "filename:" };
        return operators.Any(op => query.ToLower().Contains(op));
    }

    private SearchSortOrder ParseSortOrder(string? sort)
    {
        return sort?.ToLower() switch
        {
            "date-asc" => SearchSortOrder.DateAscending,
            "date-desc" => SearchSortOrder.DateDescending,
            "sender-asc" => SearchSortOrder.SenderAscending,
            "sender-desc" => SearchSortOrder.SenderDescending,
            "subject-asc" => SearchSortOrder.SubjectAscending,
            "subject-desc" => SearchSortOrder.SubjectDescending,
            "size-asc" => SearchSortOrder.SizeAscending,
            "size-desc" => SearchSortOrder.SizeDescending,
            "relevance" => SearchSortOrder.Relevance,
            _ => SearchSortOrder.DateDescending
        };
    }

    private string GetSortDisplayName()
    {
        var sortOrder = ParseSortOrder(Sort);
        return sortOrder switch
        {
            SearchSortOrder.DateAscending => "Date (Oldest First)",
            SearchSortOrder.DateDescending => "Date (Newest First)",
            SearchSortOrder.SenderAscending => "Sender (A-Z)",
            SearchSortOrder.SenderDescending => "Sender (Z-A)",
            SearchSortOrder.SubjectAscending => "Subject (A-Z)",
            SearchSortOrder.SubjectDescending => "Subject (Z-A)",
            SearchSortOrder.SizeAscending => "Size (Smallest First)",
            SearchSortOrder.SizeDescending => "Size (Largest First)",
            SearchSortOrder.Relevance => "Relevance",
            _ => "Date (Newest First)"
        };
    }

    private void ChangeSorting(SearchSortOrder newSort)
    {
        var sortParam = newSort switch
        {
            SearchSortOrder.DateAscending => "date-asc",
            SearchSortOrder.DateDescending => "date-desc",
            SearchSortOrder.SenderAscending => "sender-asc",
            SearchSortOrder.SenderDescending => "sender-desc",
            SearchSortOrder.SubjectAscending => "subject-asc",
            SearchSortOrder.SubjectDescending => "subject-desc",
            SearchSortOrder.SizeAscending => "size-asc",
            SearchSortOrder.SizeDescending => "size-desc",
            SearchSortOrder.Relevance => "relevance",
            _ => "date-desc"
        };

        var uri = Navigation.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["q"] = Query,
            ["page"] = 1, // Reset to first page when sorting
            ["sort"] = sortParam
        });

        Navigation.NavigateTo(uri);
    }

    private void GoToPage(int page)
    {
        if (page < 1 || (SearchResult != null && page > SearchResult.TotalPages))
            return;

        var uri = Navigation.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["q"] = Query,
            ["page"] = page,
            ["sort"] = Sort
        });

        Navigation.NavigateTo(uri);
    }

    private string TruncateText(string text, int maxLength)
    {
        if (string.IsNullOrEmpty(text) || text.Length <= maxLength)
            return text ?? "";

        return text.Substring(0, maxLength) + "...";
    }

    private string FormatFileSize(long bytes)
    {
        const int unit = 1024;
        if (bytes < unit) return $"{bytes} B";

        int exp = (int)(Math.Log(bytes) / Math.Log(unit));
        string pre = "KMGTPE"[exp - 1].ToString();
        return $"{bytes / Math.Pow(unit, exp):F1} {pre}B";
    }
}
